# Deployment target: PRODUCTION
#
# Single source of truth for the prod GCP environment. Read by both:
#   - scripts/gcp-provision.sh
#   - .github/workflows/deploy.yml  (branch `main` -> this file)
#
# Project numbers and WIF paths are NOT secrets; committing them is intended.
# Runtime secrets live in Secret Manager (SMTP_*, TURNSTILE_SECRET_KEY, …).

PROJECT_ID=ecommlab-homepage
PROJECT_NUMBER=321666316509
REGION=europe-central2
REPO=ecommlab-docker

# Cloud Run service
WEB_SERVICE=ecommlab-web

# Workload Identity Federation (GitHub OIDC) + deployer service account.
WIF_POOL=github
WIF_PROVIDER=github-oidc
DEPLOYER_SA=github-deployer

# GitHub repository allowed to assume the deployer SA via WIF.
# Format: org/repo — adjust after the repo exists on GitHub.
GITHUB_REPO=pm-ecommlab/homepage

# Public Next.js build-time env (baked into the image; not secrets).
NEXT_PUBLIC_SITE_URL=https://ecommlab.io
NEXT_PUBLIC_CONSENTOK_ID=yy1zR0KWgxD2QqYR
NEXT_PUBLIC_GTM_ID=GTM-W6XL4K9C
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACZqb55qs_rF44cY

# Custom domain via global external Application Load Balancer
# (scripts/gcp-domain.sh). Leave DNS_PROJECT/DNS_ZONE empty if DNS is
# managed outside GCP (e.g. Cloudflare) — the script then only prints the IP.
WEB_DOMAIN=ecommlab.io
DNS_PROJECT=
DNS_ZONE=
